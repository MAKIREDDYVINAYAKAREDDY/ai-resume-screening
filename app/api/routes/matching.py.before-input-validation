@router.delete("/history/{run_id}")
def delete_screening_history(
    run_id: int,
    db: Session = Depends(get_db),
):
    run = (
        db.query(ScreeningRun)
        .filter(
            ScreeningRun.id == run_id
        )
        .first()
    )

    if run is None:
        raise HTTPException(
            status_code=404,
            detail="Screening run not found.",
        )

    db.delete(run)
    db.commit()

    return {
        "message": (
            "Screening run deleted successfully."
        ),
        "run_id": run_id,
    }
